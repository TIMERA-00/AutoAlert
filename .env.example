APP_NAME=AutoAlert
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# ---------------------------------------------------------------- base de donnees
# Local (SQLite)
DB_CONNECTION=sqlite
# Docker / production (PostgreSQL)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=autoalert
# DB_USERNAME=autoalert
# DB_PASSWORD=secret

# ---------------------------------------------------------------- sessions & cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# ---------------------------------------------------------------- cache
CACHE_STORE=database

# Redis (docker-compose) : decommenter pour la production
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---------------------------------------------------------------- mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@autoalert.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (recommande en production)
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ---------------------------------------------------------------- images
# Cloudinary (recommande). Sans ces variables, les images sont stockees sur disque.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- import d annonces
IMPORT_ENABLED=true
IMPORT_TIMEOUT_MS=12000
IMPORT_MAX_BYTES=3000000
# Liste blanche de sources (separees par des virgules). Vide = aucune restriction
# au-dela des protections reseau et robots.txt.
IMPORT_ALLOWED_HOSTS=

# ---------------------------------------------------------------- WhatsApp Business
# Sans ces valeurs, les envois WhatsApp sont simules (logs uniquement).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------- assistant
# Le chatbox fonctionne sans cle : le moteur "rules" interprete la demande et
# interroge le catalogue directement. Renseignez une cle pour activer le
# moteur conversationnel (OpenAI ou tout endpoint compatible) et la
# reconnaissance de vehicule par photo.
ASSISTANT_ENABLED=true
# "openai" ou "rules". Vide = automatique : openai si une cle est presente.
ASSISTANT_DRIVER=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_VISION_MODEL=gpt-4o-mini
ASSISTANT_MAX_PHOTO_MB=6
ASSISTANT_MAX_RESULTS=4

# ---------------------------------------------------------------- seed
ADMIN_SEED_EMAIL=admin@autoalert.dev
ADMIN_SEED_PASSWORD=Admin@2024
SEED_DEMO_DATA=true
